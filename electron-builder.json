{
  "appId": "io.redstring.app",
  "productName": "Redstring",
  "icon": "electron/icon.png",
  "directories": {
    "output": "dist-electron"
  },
  "publish": ["github"],
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json",
    "agent-server.bundle.cjs"
  ],
  "asarUnpack": [
    "agent-server.bundle.cjs",
    "electron/migration/**",
    "dist/assets/save.worker*.js",
    "dist/assets/canvasWorker*.js"
  ],
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "grantFileProtocolExtraPrivileges": false,
    "loadBrowserProcessSpecificV8Snapshot": false
  },
  "mac": {
    "extraResources": [
      {
        "from": "native/afm-bridge/.build/release/afm-bridge",
        "to": "afm-bridge"
      }
    ],
    "entitlements": "entitlements.mac.plist",
    "entitlementsInherit": "entitlements.mac.plist",
    "hardenedRuntime": true,
    "category": "public.app-category.productivity",
    "artifactName": "${productName}-mac-${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ]
  },
  "win": {
    "artifactName": "${productName}-win-${arch}.${ext}",
    "verifyUpdateCodeSignature": true,
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "linux": {
    "artifactName": "${productName}-linux-${arch}.${ext}",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
