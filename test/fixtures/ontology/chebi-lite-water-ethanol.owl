        <rdfs:label>organic molecule</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_75771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75768"/>
        <obo:IAO_0000115>Any mammalian metabolite produced during a metabolic reaction in a mouse (&lt;em&gt;Mus musculus&lt;/em&gt;).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:75771</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>mouse metabolite</rdfs:label>
    </owl:Class>

