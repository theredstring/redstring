        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76946"/>
        <obo:IAO_0000115>Any  fungal metabolite produced during a metabolic reaction in Baker&apos;s yeast (&lt;em&gt;Saccharomyces cerevisiae &lt;/em&gt;).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:76949</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:76951</oboInOwl:hasAlternativeId>
