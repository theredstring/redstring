        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_139358"/>
        <obo:IAO_0000115>Any isotopically modified compound that has one or more hydrogen atoms replaced by deuterium.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:76107</oboInOwl:id>
