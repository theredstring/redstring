    </owl:Class>

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51086"/>
        <obo:IAO_0000115>A gas in an atmosphere that absorbs and emits radiation within the thermal infrared range, so contributing to the &apos;greenhouse effect&apos;.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:76413</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
