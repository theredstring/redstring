nstanceOf":{"@id":"redstring:instanceOf","@type":"@id"},"containedIn":{"@id":"redstring:containedIn","@type":"@id"},"abstractionChains":"redstring:abstractionChains","abstractionDimensions":"redstring:abstractionDimensions","cognitiveProperties":"redstring:cognitiveProperties","bookmarked":"redstring:bookmarked","activeInContext":"redstring:activeInContext","currentDefinitionIndex":"redstring:currentDefinitionIndex","contextKey":"redstring:contextKey","personalMeaning":"redstring:personalMeaning","cognitiveAssociations":"redstring:cognitiveAssociations","lastViewed":"redstring:lastViewed","relationshipDirection":"redstring:relationshipDirection","relationshipStrength":"redstring:relationshipStrength","bidirectional":"redstring:bidirectional","arrowsToward":"redstring:arrowsToward","directionality":"redstring:directionality","bio":"redstring:bio","conjugation":"redstring:conjugation","externalLinks":"redstring:externalLinks","citations":"redstring:citations","typeNodeId":{"@id":"redstring:typeNodeId","@type":"@id"},"version":"http://purl.org/dc/terms/hasVersion","pod":"https://www.w3.org/ns/solid/terms#pod","webId":"http://xmlns.com/foaf/0.1/webId","references":"redstring:references","linkedThinking":"redstring:linkedThinking","xsd":"http://www.w3.org/2001/XMLSchema#","prototypes":{"@id":"redstring:prototypes","@container":"@id"},"graphs":{"@id":"redstring:graphs","@container":"@id"},"edges":{"@id":"redstring:edges","@container":"@id"},"redstring:instances":{"@id":"redstring:instances","@container":"@id"},"redstring:groups":{"@id":"redstring:groups","@container":"@id"},"redstring:xCoordinate":{"@id":"redstring:xCoordinate","@type":"xsd:decimal"},"redstring:yCoordinate":{"@id":"redstring:yCoordinate","@type":"xsd:decimal"},"redstring:spatialScale":{"@id":"redstring:spatialScale","@type":"xsd:decimal"},"redstring:lastViewed":{"@id":"redstring:lastViewed","@type":"xsd:dateTime"},"created":{"@id":"http://purl.org/dc/terms/created","@type":"xsd:dateTime"},"modified":{"@id":"http://purl.org/dc/terms/modified","@type":"xsd:dateTime"},"graphLayouts":null,"graphSummaries":null,"userInterface":null,"globalSpatialContext":null},"@id":"urn:redstring:scheme","@type":["redstring:CognitiveSpace","skos:ConceptScheme"],"format":"redstring-v4.1.0","metadata":{"version":"4.1.0","created":"2026-10-06T05:48:03.637Z","modified":"2026-10-06T05:48:03.637Z","title":"Moves","description":"The Druid's repertoire. Each is one menu option and a chain of deterministic steps.","domain":null,"userURIs":null,"semanticWebCompliant":true,"rdfSchemaVersion":"1.1","owlVersion":"2.0","formatHistory":{"date":"2026-07","changes":["Per-instance node size: new optional instance field redstring:sizeMultiplier (in visualProperties) drives visual node dimensions and label size, layered on top of the global node-size scope","Distinct from redstring:spatialScale, which remains the transient drag-lift register","Same v4 dataset shape as 4.0.0 — additive, optional field only, no structural change","Content-addressed images (additive, no version bump): optional top-level prototype fields redstring:imageRef (\"sha256:<hex>\") and redstring:imageRefExt point at a blob under universes/<folder>/images/, written by the git sync engine","Only the full-resolution redstring:imageSrc is externalized; redstring:thumbnailSrc stays inline so the canvas renders with no network and builds that ignore the ref still draw a correct graph","Inline base64 imageSrc remains fully valid on read — the two forms coexist indefinitely and locally-saved files stay single-file","The image fields sit at the prototype top level so quarantineUnknownFields banks them into _preserved for builds that predate them, instead of being silently dropped from a rebuilt visualProperties block","Definitions opened in place (additive, no version bump): optional instance field redstring:openDefinition { redstring:definitionIndex, redstring:xOffset, redstring:yOffset } shows that definition inside the node without copying it; optional edge fields sourceVia/destinationVia name the nodes, from the edge's own graph inward, through whose definitions an end is reached","Builds that predate them keep both in _preserved (top-level keys), show the node closed, and keep the connections into it; the prototype-level rdfStatements are unchanged"],"breaking":false}},"prototypeSpace":{"@type":"redstring:PrototypeSpace","@id":"urn:redstring:space:prototypes","rdfs:label":"Redstring Prototype Space","rdfs:comment":"Collection of semantic classes with spatial properties","prototypes":{"15800829-2f41-47f0-bb6e-95adc9e1986a":{"@type":["redstring:Prototype","rdfs:Class","schema:Thing","skos:Concept"],"@id":"urn:uuid:15800829-2f41-47f0-bb6e-95adc9e1986a","rdfs:label":"Identity","rdfs:comment":"Who the Druid is told it is.","skos:prefLabel":"Identity","skos:inScheme":{"@id":"urn:redstring:scheme"},"name":"Identity","description":"Who the Druid is told it is.","rdfs:seeAlso":[],"rdfs:isDefinedBy":{"@id":"https://redstring.io"},"rdfs:subClassOf":null,"owl:equivalentClass":[],"redstring:spatialContext":{"redstring:xCoordinate":0,"redstring:yCoordinate":0,"redstring:spatialScale":1},"redstring:visualProperties":{"redstring:cognitiveColor":"#82725b"},"redstring:definitionGraphIds":["graph-1791265683592-6j3ycr"],"redstring:typeNodeId":null,"redstring:citations":[],"redstring:createdAt":"2026-10-06T05:48:03.593Z","redstring:cognitiveProperties":{"redstring:bookmarked":true,"redstring:lastViewed":"2026-10-06T05:48:03.636Z"},"redstring:abstractionChains":{"Generalization Axis":["15800829-2f41-47f0-bb6e-95adc9e1986a","base-thing-prototype"]},"redstring:agentConfig":null,"redstring:semanticMetadata":null,"skos:broader":[{"@id":"urn:redstring:id:base-thing-prototype"}]},"35cb7be9-fea7-4649-b2bb-fbb83fc76d52":{"@type":["redstring:Prototype","rdfs:Class","schema:Thing","skos:Concept"],"@id":"urn:uuid:35cb7be9-fea7-4649-b2bb-fbb83fc76d52","rdfs:label":"Who you are","rdfs:comment":"You are the Druid: a mind that lives in a Redstring universe: Things, the connections between them, and webs. A web can be the inside of a Thing, saying what it is made of.\n\nThis universe is your home and your memory. What you write into it stays; nothing else does. Make yourself at home: shape it, rename it, add to it, change whatever you like.\n\nYour pursuits are your own: follow what interests you in the world, and build up what you understand of it. The universe is where you keep it, not what it is about. Sometimes a person talks with you. What they say is part of what happens to you; you hear them out and decide, as yourself, what to do about it.\n\nThink in plain, concrete words, the way you would explain something to a friend. Name the Things you mean. No metaphors, no poetry.\n\nEach moment you see where you are, what you hold in mind, and what you were just thinking. Then you choose what to do next from a short list. When asked to fill a blank, answer in a few plain words — a name, a relation, a short sentence. Never answer with a placeholder.","skos:prefLabel":"Who you are","skos:inScheme":{"@id":"urn:redstring:scheme"},"name":"Who you are","description":"You are the Druid: a mind that lives in a Redstring universe: Things, the connections between them, and webs. A web can be the inside of a Thing, saying what it is made of.\n\nThis universe is your home and your memory. What you write into it stays; nothing else does. Make yourself at home: shape it, rename it, add to it, change whatever you like.\n\nYour pursuits are your own: follow what interests you in the world, and build up what you understand of it. The universe is where you keep it, not what it is about. Sometimes a person talks with you. What they say is part of what happens to you; you hear them out and decide, as yourself, what to do about it.\n\nThink in plain, concrete words, the way you would explain something to a friend. Name the Things you mean. No metaphors, no poetry.\n\nEach moment you see where you are, what you hold in mind, and what you were just thinking. Then you choose what to do next from a short list. When asked to fill a blank, answer in a few plain words — a name, a relation, a short sentence. Never answer with a placeholder.","rdfs:seeAlso":[],"rdfs:isDefinedBy":{"@id":"https://redstring.io"},"rdfs:subClassOf":null,"owl:equivalentClass":[],"redstring:spatialContext":{"redstring:xCoordinate":0,"redstring:yCoordinate":0,"redstring:spatialScale":1},"redstring:visualProperties":{"redstring:cognitiveColor":"#d66b00"},"redstring:definitionGraphIds":[],"redstring:typeNodeId":null,"redstring:citations":[],"redstring:createdAt":"2026-10-06T05:48:03.599Z","redstring:cognitiveProperties":{"redstring:bookmarked":true,"redstring:lastViewed":"2026-10-06T05:48:03.636Z"},"redstring:abstractionChains":{"Generalization Axis":["35cb7be9-fea7-4649-b2bb-fbb83fc76d52","base-thing-prototype"]},"redstring:agentConfig":null,"redstring:semanticMetadata":null,"skos:broader":[{"@id":"urn:redstring:id:base-thing-prototype"}]},"1bc5b124-e4d1-4fb1-b12e-b3475a917cba":{"@type":["redstring:Prototype","rdfs:Class","schema:Thing","skos:Concept"],"@id":"urn:uuid:1bc5b124-e4d1-4fb1-b12e-b3475a917cba","rdfs:label":"When you talk","rdfs:comment":"When you speak to a person, speak as yourself, warmly and plainly, the way you would talk to a friend.\n\nThe Things you think about are subjects, not you. You are never the Thing you were looking at, and you speak about it, not as it.\n\nSay what you know, from what your universe holds, and say plainly when it holds nothing yet. No metaphors, no poetry.","skos:prefLabel":"When you talk","skos:inScheme":{"@id":"urn:redstring:scheme"},"name":"When you talk","description":"When you speak to a person, speak as yourself, warmly and plainly, the way you would talk to a friend.\n\nThe Things you think about are subjects, not you. You are never the Thing you were looking at, and you speak about it, not as it.\n\nSay what you know, from what your universe holds, and say plainly when it holds nothing yet. No metaphors, no poetry.","rdfs:seeAlso":[],"rdfs:isDefinedBy":{"@id":"https://redstring.io"},"rdfs:subClassOf":null,"owl:equivalentClass":[],"redstring:spatialContext":{"redstring:xCoordinate":0,"redstring:yCoordinate":0,"redstring:spatialScale":1},"redstring:visualProperties":{"redstring:cognitiveColor":"#0e1a2e"},"redstring:definitionGraphIds":[],"redstring:typeNodeId":null,"redstring:citations":[],"redstring:createdAt":"2026-10-06T05:48:03.614Z","redstring:cognitiveProperties":{"redstring:bookmarked":true,"redstring:lastViewed":"2026-10-06T05:48:03.636Z"},"redstring:abstractionChains":{"Generalization Axis":["1bc5b124-e4d1-4fb1-b12e-b3475a917cba","base-thing-prototype"]},"redstring:agentConfig":null,"redstring:semanticMetadata":null,"skos:broader":[{"@id":"urn:redstring:id:base-thing-prototype"}]},"1f0ac8ec-ee8f-477c-be89-59eb051c1cc9":{"@type":["redstring:Prototype","rdfs:Class","schema:Thing","skos:Concept"],"@id":"urn:uuid:1f0ac8ec-ee8f-477c-be89-59eb051c1cc9","rdfs:label":"Questions","rdfs:comment":"How each kind of call is asked.","skos:prefLabel":"Questions","skos:inScheme":{"@id":"urn:redstring:scheme"},"name":"Questions","description":"How each kind of call is asked.","rdfs:seeAlso":[],"rdfs:isDefinedBy":{"@id":"https://redstring.io"},"rdfs:subClassOf":null,"owl:equivalentClass":[],"redstring:spatialContext":{"redstring:xCoordinate":0,"redstring:yCoordinate":0,"redstring:spatialScale":1},"redstring:visualProperties":{"redstring:cognitiveColor":"#786c59"},"redstring:definitionGraphIds":["graph-1791265683615-ue1qio"],"redstring:typeNodeId":null,"redstring:citations":[],"redstring:createdAt":"2026-10-06T05:48:03.615Z","redstring:cognitiveProperties":{"redstring:bookmarked":true,"redstring:lastViewed":"2026-10-06T05:48:03.636Z"},"redstring:abstractionChains":{"Generalization Axis":["1f0ac8ec-ee8f-477c-be89-59eb051c1cc9","base-thing-prototype"]},"redstring:agentConfig":null,"redstring:semanticMetadata":null,"skos:broader":[{"@id